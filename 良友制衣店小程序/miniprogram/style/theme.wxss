
/* ===== 主题变量：白天模式（在店）— 默认 ===== */
page {
  --bg-color: #FFFFFF;
  --text-color: #1A1A1A;
  --text-secondary: #666666;
  --card-bg: #F5F5F5;
  --card-border: #E8E8E8;
  --primary-color: #333333;
  --border-color: #E0E0E0;
  --status-bar-bg: #F0F0F0;
  --tag-bg: #E8E8E8;
  --input-bg: #FFFFFF;
  --shadow-color: rgba(0, 0, 0, 0.06);
  --button-bg: #1A1A1A;
  --button-text: #FFFFFF;
  --button-disabled: #CCCCCC;
  --divider-color: #ECECEC;
  --tab-active-bg: #1A1A1A;
  --tab-active-text: #FFFFFF;
  --tab-inactive-text: #666666;
}

/* ===== 暗夜模式（不在店） ===== */
page.night-mode {
  --bg-color: #1A1A1A;
  --text-color: #F0F0F0;
  --text-secondary: #AAAAAA;
  --card-bg: #2A2A2A;
  --card-border: #3A3A3A;
  --primary-color: #CCCCCC;
  --border-color: #3A3A3A;
  --status-bar-bg: #252525;
  --tag-bg: #333333;
  --input-bg: #2A2A2A;
  --shadow-color: rgba(0, 0, 0, 0.3);
  --button-bg: #F0F0F0;
  --button-text: #1A1A1A;
  --button-disabled: #444444;
  --divider-color: #333333;
  --tab-active-bg: #F0F0F0;
  --tab-active-text: #1A1A1A;
  --tab-inactive-text: #AAAAAA;
}

/* ===== 全局基础样式 ===== */
page {
  background-color: var(--bg-color);
  color: var(--text-color);
  transition: background-color 0.3s ease, color 0.3s ease;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
}

.safe-area-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
