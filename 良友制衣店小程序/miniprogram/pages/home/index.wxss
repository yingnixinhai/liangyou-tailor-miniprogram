.page-container {
  display: flex;
  flex-direction: column;
  height: 100vh; overflow: hidden; box-sizing: border-box;
  background-color: var(--bg-color);
  color: var(--text-color);
  transition: background-color 0.4s ease, color 0.4s ease;
  padding-top: 60rpx;
}

/* ===== 澶у瓧鍖哄煙 ===== */
.hero-area {
  flex: 1;
  display: flex;
  align-items: flex-start;
  justify-content: center;
  padding-top: 120rpx;
}

.hero-text-wrapper {
  text-align: center;
  position: relative;
  transition: margin-top 0.5s ease;
}

.hero-shifted {
  margin-top: 10vh;
}

.hero-line {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 180rpx;
  line-height: 180rpx;
}

.hero-char-bu {
  font-size: 160rpx;
  font-weight: 700;
  transition: opacity 0.5s ease, color 0.5s ease;
  color: #FFFFFF;
  position: relative;
  z-index: 2;
}

.bu-hidden {
  opacity: 0;
}

.bu-visible {
  opacity: 1;
}

.hero-char-main {
  font-size: 160rpx;
  font-weight: 700;
  color: var(--text-color);
  transition: color 0.4s ease;
  margin: 0 20rpx;
}

.hero-char-main:first-child {
  margin-right: 40rpx;
}

.hero-char-main:last-child {
  margin-left: 40rpx;
}

/* ===== 鐘舵€佷俊鎭尯鍩?===== */
.info-section {
  padding: 0 60rpx 40rpx;
}

.info-row {
  display: flex;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.info-row-note {
  border-bottom: none;
}

.info-label {
  font-size: 30rpx;
  color: var(--text-secondary);
  width: 150rpx;
  flex-shrink: 0;
}

.info-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-color);
  margin-left: 20rpx;
}

.info-value-note {
  font-size: 30rpx;
  font-weight: 400;
  flex: 1;
  word-break: break-all;
  line-height: 1.5;
}

.info-placeholder {
  font-size: 30rpx;
  color: var(--button-disabled);
  margin-left: 20rpx;
}

/* ===== 鍒囨崲鎸夐挳 ===== */
.toggle-btn-section {
  padding: 30rpx 60rpx;
}

.toggle-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  border-radius: 12rpx;
  background-color: var(--button-bg);
  color: var(--button-text);
  border: none;
  transition: opacity 0.3s ease;
}

.toggle-btn:active {
  opacity: 0.8;
}

.btn-disabled {
  opacity: 0.5;
}

/* ===== 鍒囨崲鍔ㄧ敾閬僵 ===== */
.switch-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  pointer-events: none;
  z-index: 100;
}

.switch-active {
  /* 鍔ㄧ敾鐢?JS 閫氳繃 clip-path 鎺у埗 */
}