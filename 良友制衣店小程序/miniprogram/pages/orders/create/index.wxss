
.create-page {
  height: 100vh; overflow-y: auto; box-sizing: border-box;
  background-color: var(--bg-color);
  transition: background-color 0.3s ease;
  padding: 20rpx 0;
}

.form-section {
  padding: 20rpx 30rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 16rpx;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background-color: var(--input-bg);
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 20rpx;
  font-size: 28rpx;
  color: var(--text-color);
  box-sizing: border-box;
}

.form-input {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background-color: var(--input-bg);
  border: 1rpx solid var(--border-color);
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 28rpx;
  color: var(--text-color);
  box-sizing: border-box;
}

.image-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.image-item {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  overflow: hidden;
  position: relative;
}

.preview-img {
  width: 100%;
  height: 100%;
}

.image-remove {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.5);
  color: #fff;
  text-align: center;
  line-height: 36rpx;
  font-size: 28rpx;
}

.image-add {
  width: 160rpx;
  height: 160rpx;
  border: 2rpx dashed var(--border-color);
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 48rpx;
  color: var(--text-secondary);
}

.submit-section {
  padding: 40rpx 30rpx 60rpx;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 12rpx;
  background-color: var(--button-bg);
  color: var(--button-text);
  border: none;
}

.btn-disabled { opacity: 0.5; }

.picker-value { display: flex; align-items: center; color: var(--text-color); }
.picker-value:empty { color: var(--text-secondary); }

.time-picker-row { display: flex; gap: 16rpx; }
.time-picker-row picker { flex: 1; }
