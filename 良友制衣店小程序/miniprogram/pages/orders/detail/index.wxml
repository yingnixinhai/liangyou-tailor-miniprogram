<view class="detail-page {{pageClass}}">

  <view wx:if="{{loading}}" class="loading-wrap">
    <text class="loading-text">加载中...</text>
  </view>

  <view wx:else class="detail-content">

    <!-- 操作栏 -->
    <view class="action-bar">
      <view class="action-btn edit-btn" bindtap="onEdit">
        <text>编辑</text>
      </view>
      <view class="action-btn delete-btn" bindtap="onDelete">
        <text>删除</text>
      </view>
    </view>

    <!-- 图片区域 -->
    <view class="image-section" wx:if="{{hasImages}}">
      <image
        class="detail-image"
        src="{{item}}"
        mode="aspectFill"
        wx:for="{{images}}"
        wx:key="*this"
        data-url="{{item}}"
        bindtap="onPreviewImage"
      />
    </view>

    <!-- 信息列表 -->
    <view class="info-list">
      <view class="info-item info-item-full">
        <view class="info-label">订单需求</view>
        <view class="info-value-text">{{reqText}}</view>
      </view>

      <view class="info-item">
        <text class="info-label">创建时间</text>
        <text class="info-value">{{createTime}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">预计完成</text>
        <text class="info-value">{{expectedTime}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">完成时间</text>
        <text class="info-value">{{completeTime}}</text>
      </view>

      <view class="info-item" wx:if="{{showAmount}}">
        <text class="info-label">订单金额</text>
        <text class="info-value">{{amountText}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">客户姓名</text>
        <text class="info-value">{{customerName}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">联系电话</text>
        <text class="info-value">{{customerPhone}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">订单状态</text>
        <text class="info-value status-badge {{orderStatus}}">{{statusText}}</text>
      </view>
    </view>

    <!-- 商家操作按钮 -->
    <view class="action-section" wx:if="{{isAdmin && statusActions.length > 0}}">
      <button
        class="action-btn-main"
        data-next-status="{{item.nextStatus}}"
        bindtap="onStatusAction"
        wx:for="{{statusActions}}"
        wx:key="nextStatus"
      >
        {{item.label}}
      </button>
    </view>

  </view>

</view>