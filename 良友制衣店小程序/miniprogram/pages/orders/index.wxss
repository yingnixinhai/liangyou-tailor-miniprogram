
.orders-page { display: flex; flex-direction: column;
  height: 100vh; overflow: hidden; box-sizing: border-box;
  background-color: var(--bg-color);
  transition: background-color 0.3s ease;
  padding-bottom: 120rpx;
}

.order-list {
  flex: 1; height: 0;
}

.empty-state {
  display: flex;
  justify-content: center;
  align-items: center;
  padding-top: 200rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-secondary);
}

.loading-state {
  text-align: center;
  padding: 30rpx 0;
}

.loading-text {
  font-size: 26rpx;
  color: var(--text-secondary);
}

.fab-wrap {
  position: fixed;
  right: 40rpx;
  bottom: 140rpx;
  z-index: 50;
}

.fab-btn {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: var(--button-bg);
  color: var(--button-text);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
  transition: transform 0.2s ease;
}

.fab-btn:active {
  transform: scale(0.92);
}

.fab-icon { font-size: 48rpx; font-weight: 300; line-height: 1; }

/* ===== 批量操作面板 ===== */
.batch-panel {
  position: fixed; left: 0; right: 0; bottom: 0;
  background-color: var(--bg-color);
  border-top: 1rpx solid var(--border-color);
  z-index: 50;
  padding: 20rpx 30rpx calc(20rpx + env(safe-area-inset-bottom));
}
.batch-header {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: 16rpx;
}
.batch-count { font-size: 26rpx; color: var(--text-secondary); }
.batch-cancel { font-size: 26rpx; color: #1565C0; padding: 8rpx 0; }
.batch-actions-row { display: flex; gap: 12rpx; }
.batch-btn {
  display: flex; align-items: center; justify-content: center;
  flex: 1; height: 72rpx; line-height: 72rpx;
  font-size: 26rpx; font-weight: 600;
  border-radius: 10rpx; border: none;
  background-color: var(--button-bg); color: var(--button-text);
}


.batch-btn { background-color: var(--card-bg); color: var(--text-color); }

/* ===== 暗夜模式 ===== */
.night-mode .batch-panel { background-color: #1A1A1A; border-top-color: #333; }
.night-mode .batch-btn { background-color: #333; color: #eee; }
.night-mode 

.night-mode .batch-btn.select-all { background-color: #2A2A2A; color: #eee; }
