
<view class="orders-page {{pageClass}}">

  <status-tabs
    activeTab="{{activeTab}}"
    theme="{{theme}}"
    bind:change="onTabChange"
  />

  <!-- 订单列表 -->
  <scroll-view
    class="order-list"
    scroll-y
    bindscrolltolower="onReachBottom"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view wx:if="{{orders.length === 0 && !loading}}" class="empty-state">
      <text class="empty-text">暂无订单</text>
    </view>

    <block wx:for="{{orders}}" wx:key="_id">
      <order-card
        order="{{item}}"
        theme="{{theme}}"
        selectable="{{batchMode}}"
        allSelectedIds="{{selectedIds}}" orderId="{{item._id}}"
        bind:cardtap="onOrderTap"
        bind:longpress="onOrderLongPress"
      />
    </block>

    <view wx:if="{{loading}}" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>
  </scroll-view>

  <!-- 批量操作面板 -->
  <view wx:if="{{batchMode}}" class="batch-panel safe-area-bottom">
    <view class="batch-header">
      <text class="batch-count">已选 {{selectedIds.length}} 项</text>
      <text class="batch-cancel" bindtap="onExitBatchMode">取消</text>
    </view>
    <view class="batch-actions-row">
      <button class="batch-btn select-all" bindtap="onSelectAll">{{selectAllLabel}}</button>
      <button class="batch-btn action" bindtap="onBatchUpdateStatus">{{batchActionLabel}}</button>
      <button class="batch-btn danger" bindtap="onBatchDelete">批量删除</button>
    </view>
  </view>

  <!-- 新建按钮 -->
  <view wx:if="{{!batchMode}}" class="fab-wrap">
    <view class="fab-btn" bindtap="onCreateOrder">
      <text class="fab-icon">+</text>
    </view>
  </view>

</view>
