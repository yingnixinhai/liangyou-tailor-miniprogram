
.tabs-bar {
  display: flex;
  background-color: var(--status-bar-bg);
  border-radius: 12rpx;
  margin: 20rpx 30rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 10rpx;
  transition: all 0.3s ease;
}

.tab-active {
  background-color: var(--tab-active-bg);
}

.tab-text {
  font-size: 28rpx;
  color: var(--tab-inactive-text);
  font-weight: 500;
}

.tab-active .tab-text {
  color: var(--tab-active-text);
  font-weight: 600;
}
