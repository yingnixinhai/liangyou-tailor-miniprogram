
<view class="orders-page {{pageClass}}">

  <status-tabs
    activeTab="{{activeTab}}"
    theme="{{theme}}"
    bind:change="onTabChange"
  />

  <!-- 管理员操作栏 -->
  <view wx:if="{{isAdmin && !batchMode}}" class="admin-actions">
    <view class="one-click-row">
      <button class="one-click-btn" bindtap="onBatchAllAction">{{batchAllLabel}}</button>
      <button class="one-click-btn danger" bindtap="onBatchAllDelete">一键删除</button>
    </view>
    <button class="batch-toggle-btn" bindtap="onToggleBatchMode">批量管理</button>
  </view>

  <!-- 批量模式栏 -->
  <view wx:if="{{isAdmin && batchMode}}" class="batch-bar">
    <button class="batch-cancel-btn" bindtap="onToggleBatchMode">取消</button>
    <text class="batch-count">已选 {{selectedIds.length}} 项</text>
    <button class="batch-select-btn" bindtap="onSelectAll">{{selectAllLabel}}</button>
  </view>

  <!-- 订单列表 -->
  <scroll-view
    class="order-list"
    scroll-y
    bindscrolltolower="onReachBottom"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view wx:if="{{orders.length === 0 && !loading}}" class="empty-state">
      <text class="empty-text">暂无订单</text>
    </view>

    <block wx:for="{{orders}}" wx:key="_id">
      <order-card
        order="{{item}}"
        theme="{{theme}}"
        selectable="{{batchMode}}"
        checked="{{selectedIds.indexOf(item._id) > -1}}"
        bind:cardtap="onOrderTap"
      />
    </block>

    <view wx:if="{{loading}}" class="loading-state">
      <text class="loading-text">加载中...</text>
    </view>
  </scroll-view>

  <!-- 批量操作按钮（底部） -->
  <view wx:if="{{batchMode}}" class="batch-actions safe-area-bottom">
    <button class="batch-action-btn danger" bindtap="onBatchDelete">批量删除 ({{selectedIds.length}})</button>
    <button class="batch-action-btn" bindtap="onBatchUpdateStatus">{{batchActionLabel}} ({{selectedIds.length}})</button>
  </view>

  <!-- 新建按钮 -->
  <view wx:if="{{!batchMode}}" class="fab-wrap">
    <view class="fab-btn" bindtap="onCreateOrder">
      <text class="fab-icon">+</text>
    </view>
  </view>

</view>
