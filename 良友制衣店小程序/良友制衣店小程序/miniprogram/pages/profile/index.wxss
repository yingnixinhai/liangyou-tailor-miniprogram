.profile-page {
  height: 100vh; overflow-y: auto; box-sizing: border-box;
  background-color: var(--bg-color);
  transition: background-color 0.3s ease;
  padding-bottom: 40rpx;
}

.profile-header {
  display: flex;
  align-items: center;
  padding: 60rpx 30rpx 40rpx;
}

.avatar-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  background-color: var(--border-color);
}

.avatar {
  width: 100%;
  height: 100%;
}

.user-meta {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.user-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-color);
}

.user-role {
  font-size: 24rpx;
  color: #1565C0;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  background-color: #E3F2FD;
  border-radius: 8rpx;
  align-self: flex-start;
}

.user-role-customer {
  color: #666666;
  background-color: var(--card-bg);
}

/* ===== 账户管理 ===== */
.account-section, .settings-section, .about-section {
  padding: 0rpx 30rpx 20rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-color);
  margin-bottom: 16rpx;
  padding-top: 20rpx;
}

.account-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.account-label {
  font-size: 28rpx;
  color: var(--text-color);
}

.account-right {
  display: flex;
  align-items: center;
}

.account-avatar {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
}

.account-value {
  font-size: 28rpx;
  color: var(--text-secondary);
}

/* ===== 设置区 ===== */
.setting-item, .about-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 0;
  border-bottom: 1rpx solid var(--border-color);
}

.setting-item:active {
  opacity: 0.7;
}

.setting-label, .about-label {
  font-size: 28rpx;
  color: var(--text-color);
}

.setting-right {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.setting-value {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.setting-arrow {
  font-size: 36rpx;
  color: var(--text-secondary);
  line-height: 1;
}

.about-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.about-value {
  font-size: 28rpx;
  color: var(--text-secondary);
}

.about-value-detail {
  max-width: 240rpx;
  overflow: hidden;
}

.detail-link {
  font-size: 24rpx;
  color: #1565C0;
  padding: 4rpx 12rpx;
  border: 1rpx solid #1565C0;
  border-radius: 8rpx;
  flex-shrink: 0;
}

/* 暗夜模式 */
.night-mode .user-role {
  background-color: #1A237E;
  color: #90CAF9;
}

.night-mode .user-role-customer {
  color: #AAAAAA;
  background-color: #2A2A2A;
}

.night-mode .detail-link {
  border-color: #90CAF9;
  color: #90CAF9;
}